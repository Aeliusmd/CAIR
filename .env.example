# Master database (lists active clinics)
MASTER_DB_CONNECTION=Driver={ODBC Driver 17 for SQL Server};Server=localhost;Database=MasterClinic;Trusted_Connection=yes;

# CAIR2 SOAP — ONBOARDING (Aeliusmd SF-013259)
# WSDL: https://cdph-interop-stage.cdph.ca.gov/CASTG-WS/IISService?WSDL
CAIR_SOAP_URL=https://cdph-interop-stage.cdph.ca.gov/services/client_Service.client_ServiceHttpSoap12Endpoint
CAIR_SOAP_WSDL=https://cdph-interop-stage.cdph.ca.gov/CASTG-WS/IISService?WSDL

# CAIR2 SOAP — PRODUCTION (use after onboarding approval)
# CAIR_SOAP_URL=https://cdph-interop-prod.cdph.ca.gov/services/client_Service.client_ServiceHttpSoap12Endpoint
# CAIR_SOAP_WSDL=https://cdph-interop-prod.cdph.ca.gov/CAPRD-WS/IISService?WSDL

CAIR_SOAP_USERNAME=
CAIR_SOAP_PASSWORD=

# Worker settings
WORKER_BATCH_SIZE=100
WORKER_POOL_SIZE=3
SCHEDULER_INTERVAL_SECONDS=300
MAX_RETRY_ATTEMPTS=5

# Aeliusmd CAIR org code (from onboarding email)
SENDING_FACILITY_ID=SF-013259
RESPONSIBLE_ORG_ID=SF-013259
RECEIVING_FACILITY=CAIR2
PROCESSING_ID=P
