# qa | development
APP_ENV=development

# --- Development (direct clinic DB, e.g. Sithum) ---
# Use when the clinic DB is not registered in ClinicSetup.
CLINIC_DB_SERVER=10.103.0.211
CLINIC_DB_NAME=ClaudMD_Development_Sithum
CLINIC_DB_USER=testuser
CLINIC_DB_PASSWORD=
CLINIC_ID=0
CLINIC_NAME=Development Sithum

# Optional: single clinic connection string instead of the above
# CLINIC_DB_CONNECTION=Driver={ODBC Driver 17 for SQL Server};Server=...

# --- QA (master DB + ClinicSetup lookup) ---
# Comment out CLINIC_DB_* and use these instead for multi-clinic QA.
# MASTER_DB_SERVER=10.103.0.201
# MASTER_DB_NAME=ClaudMD_QA_Setup
# MASTER_DB_USER=testuser
# MASTER_DB_PASSWORD=
# DEFAULT_ACTIVATION_KEY=20000002

MASTER_DB_DRIVER=ODBC Driver 17 for SQL Server

# Optional: single master connection string instead of MASTER_DB_*
# MASTER_DB_CONNECTION=Driver={ODBC Driver 17 for SQL Server};Server=...

# CAIR2 SOAP — ONBOARDING (Aeliusmd SF-013259)
CAIR_SOAP_URL=https://cdph-interop-stage.cdph.ca.gov/services/client_Service.client_ServiceHttpSoap12Endpoint
CAIR_SOAP_WSDL=https://cdph-interop-stage.cdph.ca.gov/CASTG-WS/IISService?WSDL
CAIR_SOAP_USERNAME=
CAIR_SOAP_PASSWORD=

# Worker settings
WORKER_BATCH_SIZE=100
WORKER_POOL_SIZE=3
SCHEDULER_INTERVAL_SECONDS=300
MAX_RETRY_ATTEMPTS=5

# CAIR org code
SENDING_FACILITY_ID=SF-013259
RESPONSIBLE_ORG_ID=SF-013259
RECEIVING_FACILITY=CAIR2
PROCESSING_ID=P
